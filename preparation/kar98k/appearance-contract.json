{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "title":"Kar98k nonfunctional game-art parameter draft — no model generated",
 "type":"object","additionalProperties":false,
 "required":["artScale","detail","woodColor","metalColor","roughness","weathering","showSling"],
 "properties":{
  "artScale":{"type":"number","minimum":0.85,"maximum":1.15,"description":"Unitless whole-prop artistic scale; not a real measurement"},
  "detail":{"type":"string","enum":["low","medium","high"],"description":"Future fixed authored exterior tiers; no tier exists yet"},
  "woodColor":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},
  "metalColor":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},
  "roughness":{"type":"number","minimum":0.35,"maximum":1},
  "weathering":{"type":"number","minimum":0,"maximum":1},
  "showSling":{"type":"boolean","description":"Cosmetic exterior strap visibility only"}
 }
}
