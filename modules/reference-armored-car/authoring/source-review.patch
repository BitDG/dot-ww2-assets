+    m.diffuse_color=(*color,1)
+    b=m.node_tree.nodes.get('Principled BSDF');b.inputs['Base Color'].default_value=(*color,1)
+    b.inputs['Roughness'].default_value=rough;b.inputs['Metallic'].default_value=metal
+    return m
+armor=material('armor',(.255,.205,.123),.81,.12)
+edge=material('armor-edge',(.31,.255,.155),.76,.2)
+steel=material('steel',(.085,.074,.05),.65,.67)
+dark=material('dark',(.047,.043,.031),.91,.2)
+rubber=material('rubber',(.064,.061,.049),.94)
+canvas=material('canvas',(.235,.204,.133),.96)
+strap=material('strap',(.13,.103,.06),.9)
+white=material('marking',(.76,.745,.665),.86)
+wood=material('wood',(.29,.15,.065),.9)
+lens=material('lens',(.55,.59,.54),.3,.32)
+
+def empty(name,parent=None,pos=(0,0,0)):
